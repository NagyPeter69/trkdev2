# Disposable job/media content - never tracked, deliberately excluded from this rebuild
client/packages/
client/assets/
client/temp/
client/handout/
client/labor/
client/uploads/
client/advertisements/
dynAPI/tracker/
dynAPI/rendered/
dynAPI/op/rendered/

# client/engine/r3/'s scratch render output (compare.php / flatplan_reloadbg.php /
# tesztAjax.php's render cache) - not r3API/r3/ below, that's the separate
# licensed-binary directory. 126 of these files were accidentally swept into
# the "Initial commit: trkdev2 baseline" snapshot and re-touched by a later
# unrelated commit; confirmed via the 2026-08-02 audit that every one of them
# matches a purely runtime-generated naming pattern (bg<id>.jpg,
# compare_<a>_<b>.jpg, bgcomp_<id>*.jpg, <id>_diff_<ts>.png, _cache_<hash>.jpg)
# with no exceptions, so untracking the whole directory rather than picking
# through it file by file. See client/cron/r3_cleaner.php for the actual
# cleanup (age-based sweep, same as the other client/cron/*_cleaner.php jobs).
client/engine/r3/

# switchReports/ (repo root, NOT client/ - served directly, see teszt.php's
# report link) holds per-job Switch preflight reports (HTML + JPEGs, random
# report-ID filenames). Same accidental-tracking mistake as r3/ above, at
# 10x the scale: 1210 files going back to 2021, confirmed via the
# 2026-08-02 audit that cleanupPublicationRemnants() had been pointed at
# the wrong path (/var/www/switchReports/, essentially empty) this whole
# time and never actually cleaned any of this up - now fixed to target this
# directory instead, so keep it out of version control entirely rather
# than repeat the mistake. css/ and images/ are the shared report
# template's static assets (style.css, the logo), not per-job output -
# keep those tracked.
switchReports/*
!switchReports/css/
!switchReports/images/

# Runtime-generated
*.log
*.tmp

# Per-issue/per-publication XML snapshots in client/xml/ - regenerated on
# every issue or Adhoc-publication create/modify/status-change and pushed
# to Switch. MariaDB is the ground truth, these are disposable outbound
# artifacts. Naming isn't consistent enough to pattern-match (Regular
# issues: {magCode}_{issueCode}.xml: Adhoc publications: just {code}.xml,
# no underscore) so this whitelists the two files that ARE meant to be
# tracked instead of trying to exclude every generated variant.
client/xml/*
!client/xml/pmd.xml
!client/xml/re-generateXML.php

# R3 (PDF rendering) binary + ICC profile bundle - a licensed third-party tool,
# same category as DynaPDF's .so: not application code, not tracked here.
# See SYSTEM_STATE.md's "R3" section for what has to be present at r3API/r3/
# and the permission/capability setup needed for it to actually work.
r3API/r3/
rendertest.pdf
rendertest.jpg

# Switch webhook debug dump (handler.php's per-request var_dump log, named
# logs/<fileName>_<event>-<time>.txt) and two append-only per-request debug
# logs page_pdf-handler.php writes via fopen(..., 'a+') in its own cwd -
# pure runtime debug output, not application state.
client/engine/switch/logs/
client/engine/switch/pagestate.txt
client/engine/switch/pageversion.txt

# r3 command/output debug logs (the shell command + args logged before each
# r3remote call) - not the same as client/engine/r3/'s cached render output
# above, which is the actual render result these just precede.
client/engine/switch/r3Thumb.txt
client/r3Thumb.txt

# Cron mutex lock (empty when idle, touched by
# client/cron/switch_sync_worker.php) and a simple runtime message counter -
# state, not code.
client/cron/switch_sync_worker.lock
client/message.counter

# AUTOCOMPARE's literal, hardcoded output path (page_pdf-handler.php) -
# whatever the last comparison run happened to conclude, not a fixture.
client/tests/B-E.out

# One-off manual test uploads, not the established client/engine/dyna/
# fixture set (after.jpg/before.jpg/ajaxteszt_*.jpg/right319.jpg, which ARE
# tracked) - inconsistent with that set's naming/sizing.
client/engine/dyna/right7.jpg
client/engine/dyna/test.pdf

# Scratch output from a manual r3API/getpdfbox.php test run (timestamp-
# prefixed filename) - not source despite the directory name.
r3API/source/
